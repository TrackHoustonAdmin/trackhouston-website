---
interface Coach {
  name: string;
  phone: string;
}
interface Props {
  area: string;
  facility: string;
  address: string;
  coaches: Coach[];
  schedule: string;
  program: 'Track & Field' | 'Cross Country';
  note?: string;
}
const { area, facility, address, coaches, schedule, program, note } = Astro.props;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${facility}, ${address}`)}`;
---

<article class="reveal group border border-line bg-white flex flex-col">
  <div class="border-l-4 border-th-red px-5 py-4 flex items-baseline justify-between gap-3">
    <h3 class="font-condensed font-semibold uppercase tracking-[0.06em] text-2xl leading-none">
      {area}
    </h3>
    <p class="kicker text-steel whitespace-nowrap">{program}</p>
  </div>
  <div class="px-5 pb-5 flex flex-col gap-4 flex-1">
    <div>
      <p class="font-medium">{facility}</p>
      <a
        href={mapsUrl}
        rel="external noopener"
        class="text-steel text-sm underline decoration-line underline-offset-4 hover:text-th-red hover:decoration-th-red transition-colors"
      >
        {address}
      </a>
    </div>
    <p class="text-sm text-ink/80 border-t border-line pt-4">
      <span class="kicker text-steel block mb-1">Practice</span>
      {schedule}
    </p>
    {note && <p class="text-xs text-steel leading-relaxed -mt-1">{note}</p>}
    {
      coaches.length > 0 && (
        <div class="border-t border-line pt-4 mt-auto">
          <span class="kicker text-steel block mb-2">Site coaches</span>
          <ul class="space-y-1.5">
            {coaches.map((c) => (
              <li class="flex items-baseline justify-between gap-3 text-sm">
                <span class="font-medium">{c.name}</span>
                <a href={`tel:${c.phone.replace(/[^0-9]/g, '')}`} class="text-steel hover:text-th-red transition-colors whitespace-nowrap">
                  {c.phone}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>
