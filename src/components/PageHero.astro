---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  kicker: string;
  title: string;
  intro?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { kicker, title, intro, image, imageAlt = '' } = Astro.props;
---

<section class="relative bg-th-red text-white overflow-hidden">
  {
    image && (
      <>
        <Image
          src={image}
          alt={imageAlt}
          class="absolute inset-0 h-full w-full object-cover object-[center_30%] opacity-35"
          loading="eager"
          fetchpriority="high"
          widths={[640, 1024, 1600, 2400]}
          sizes="100vw"
          quality={75}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-th-red via-th-red/70 to-th-red-deep/40" aria-hidden="true" />
      </>
    )
  }
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-16 pb-14 sm:pt-24 sm:pb-20">
    <p class="kicker text-white/85">{kicker}</p>
    <h1 class="display text-5xl sm:text-7xl lg:text-8xl mt-4 max-w-4xl">{title}</h1>
    {intro && <p class="mt-6 max-w-2xl text-white/90 text-lg leading-relaxed">{intro}</p>}
    <slot />
  </div>
</section>
