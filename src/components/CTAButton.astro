---
/**
 * The single primary CTA for the whole site.
 * If the registration platform ever changes, update the URLs in src/data/site.json —
 * every CTA flows through /register, so nothing else needs to change.
 * Secondary variant available for supporting actions.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
}
const { href = '/register', variant = 'primary', class: className = '' } = Astro.props;

const base =
  'inline-flex items-center gap-3 font-condensed font-semibold uppercase tracking-[0.14em] text-base px-7 py-3.5 transition-colors duration-150';
const variants = {
  primary: 'cta-sweep bg-ink text-white hover:text-white',
  secondary: 'border-2 border-ink text-ink hover:bg-ink hover:text-white',
  ghost: 'border-2 border-white/90 text-white hover:bg-white hover:text-th-red',
};
---

<a href={href} class={`${base} ${variants[variant]} ${className}`}>
  <slot>Join Track Houston</slot>
  <svg aria-hidden="true" width="18" height="12" viewBox="0 0 18 12" fill="none" class="shrink-0">
    <path d="M11.5 1l5 5-5 5M16 6H1" stroke="currentColor" stroke-width="2" />
  </svg>
</a>
