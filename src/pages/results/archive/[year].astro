---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import manifest from '../../../data/archive/manifest.json';
import meets from '../../../data/archive/meets.json';
import thAll from '../../../data/archive/track-houston.json';

export async function getStaticPaths() {
  const years = (manifest as { year: string }[]).map((m) => m.year);
  return years.map((year) => ({ params: { year } }));
}

const { year } = Astro.params;
const data = (await import(`../../../data/archive/${year}.json`)).default as {
  year: string;
  parts: { source: string; kind: string; sections: { title: string; body: string }[] }[];
};
type Meet = { title: string; location: string; sanction: string; partLabels?: string[] };
const info = (meets as Record<string, Meet>)[year!];
const th = (thAll as { year: string; section: string; excerpt: string }[]).filter(
  (m) => m.year === year
);
const totalSections = data.parts.reduce((n, p) => n + p.sections.length, 0);
const isOCR = data.parts.some((p) => p.kind === 'ocr');
---

<Layout
  title={`${year} ${info?.title ?? 'Junior Olympic Results'} — Track Houston Archive`}
  description={`Complete ${year} ${info?.title ?? 'Junior Olympic'} results${info?.location ? ` from ${info.location}` : ''} — part of the Track Houston results archive.`}
>
  <PageHero
    kicker={`Results Archive · ${info?.sanction ?? ''}`}
    title={year!}
    intro={`${info?.title ?? 'National Junior Olympic results'}${info?.location ? ` — ${info.location}` : ''}. ${totalSections} result sections, preserved from the original documents.`}
  />

  <!-- Track Houston highlights for this year -->
  {
    th.length > 0 && (
      <section class="bg-ink text-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 lg:py-16">
          <p class="kicker text-th-red">Track Houston in {year}</p>
          <div class="mt-6 grid md:grid-cols-2 gap-5">
            {th.slice(0, 18).map((m) => (
              <article class="border border-white/20 border-l-4 border-l-th-red p-5">
                <p class="kicker text-white/70">{m.section}</p>
                <pre class="mt-3 font-mono text-xs sm:text-sm text-white/85 overflow-x-auto whitespace-pre">{m.excerpt}</pre>
              </article>
            ))}
          </div>
          {
            th.length > 18 && (
              <p class="mt-6 text-white/70">
                Showing 18 of {th.length} Track Houston appearances in the {year} book — type
                "Track Houston" in the search box below to see every one in the full results.
              </p>
            )
          }
        </div>
      </section>
    )
  }

  <!-- Full results -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-12 lg:py-16">
    <div class="flex flex-col sm:flex-row gap-4 sm:items-center justify-between">
      <h2 class="display text-3xl sm:text-4xl">Complete results</h2>
      <label class="flex items-center gap-3 border-2 border-ink px-4 py-2.5 w-full sm:max-w-xs focus-within:border-th-red transition-colors">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 text-steel">
          <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="2"/><path d="M11 11l4 4" stroke="currentColor" stroke-width="2"/>
        </svg>
        <input
          id="archive-search"
          type="search"
          placeholder="Search names, events…"
          aria-label="Search these results"
          class="w-full bg-transparent outline-none font-condensed font-medium uppercase tracking-[0.06em] placeholder:text-steel"
        />
      </label>
    </div>

    {
      isOCR && (
        <p class="mt-4 text-steel text-sm max-w-3xl">
          These results were digitized by optical character recognition from scanned documents from
          {' '}{year} — occasional character errors are possible. The original PDFs remain the
          authoritative record.
        </p>
      )
    }

    <div class="mt-8 space-y-10" id="archive-root">
      {
        data.parts.map((part, pi) => (
          <div>
            {data.parts.length > 1 && (
              <h3 class="kicker text-steel border-b-2 border-ink pb-2 mb-4">
                {info?.partLabels?.[pi] ?? `Document ${pi + 1}`}
              </h3>
            )}
            <div class="space-y-2">
              {part.sections.map((s) => (
                <details data-section class="group border border-line bg-white">
                  <summary class="cursor-pointer list-none px-4 py-3 flex items-center justify-between gap-4 font-condensed font-semibold uppercase tracking-[0.05em] hover:text-th-red transition-colors">
                    <span data-title>{s.title}</span>
                    <span class="text-th-red text-xl leading-none group-open:rotate-45 transition-transform shrink-0" aria-hidden="true">+</span>
                  </summary>
                  <pre data-body class="px-4 pb-4 font-mono text-xs sm:text-[0.8rem] leading-relaxed overflow-x-auto whitespace-pre text-ink/85">{s.body}</pre>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <p class="mt-10">
      <a href="/results/archive" class="kicker text-ink hover:text-th-red transition-colors">← All archive years</a>
    </p>
  </section>

  <script>
    const input = document.getElementById('archive-search') as HTMLInputElement;
    const sections = [...document.querySelectorAll<HTMLDetailsElement>('[data-section]')];
    const index = sections.map((el) => ({
      el,
      text: (
        (el.querySelector('[data-title]')?.textContent || '') +
        ' ' +
        (el.querySelector('[data-body]')?.textContent || '')
      ).toLowerCase(),
    }));
    let t: number | undefined;
    input?.addEventListener('input', () => {
      clearTimeout(t);
      t = window.setTimeout(() => {
        const q = input.value.trim().toLowerCase();
        for (const { el, text } of index) {
          const match = !q || text.includes(q);
          el.hidden = !match;
          if (q && match) el.open = true;
          if (!q) el.open = false;
        }
      }, 150);
    });
  </script>
</Layout>
