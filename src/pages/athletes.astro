---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import athletes from '../data/athletes.json';
import portraitBW from '../assets/photos/portrait-foreman-bw.jpg';
import relayExchange from '../assets/photos/maryann-chloe-relay.jpg';
import bryceDeadmon from '../assets/photos/bryce-deadmon.jpg';
import alayshaJohnson from '../assets/photos/alaysha-johnson-paris.jpg';

const spotlightImages: Record<string, ImageMetadata> = {
  'bryce-deadmon': bryceDeadmon,
  'alaysha-johnson-paris': alayshaJohnson,
};
---

<Layout
  noindex
  title="Athletes — Track Houston Youth Track Club"
  description="From Olympic gold medalist Bryce Deadmon to this year's national champions and 95+ alumni on college scholarships — meet the athletes of Track Houston."
>
  <PageHero
    kicker="Athletes"
    title="Houston made."
    intro="National champions, record holders, college signees, an Olympic gold medalist. They all started the same way — at a Track Houston practice."
    image={portraitBW}
    imageAlt="Black-and-white portrait of a young Track Houston athlete before his race at nationals."
  >
    <div class="mt-8">
      <CTAButton href="/roster" variant="ghost">View the Full Team Roster</CTAButton>
    </div>
  </PageHero>

  <!-- Alumni spotlights -->
  {
    athletes.spotlights.map((sp, i) => (
      <section class={i % 2 === 0 ? 'bg-th-red text-white' : 'bg-ink text-white'}>
        <div class="mx-auto max-w-7xl px-4 sm:px-6 py-20 lg:py-28 grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
            <SectionHeading light kicker="Alumni Spotlight" title={sp.name} />
            <p class="reveal kicker text-white mt-4">{sp.title}</p>
            <p class="reveal mt-5 text-white/90 leading-relaxed max-w-lg">{sp.body}</p>
            <div class="reveal mt-8 grid grid-cols-3 gap-6 border-t border-white/30 pt-8 max-w-lg">
              {sp.stats.map((s) => (
                <div>
                  <p class={`display text-3xl sm:text-4xl ${i % 2 === 1 ? 'text-th-red' : 'text-white'}`}>{s.value}</p>
                  <p class="mt-1 text-white/80 text-xs font-condensed font-medium uppercase tracking-[0.08em]">{s.label}</p>
                </div>
              ))}
            </div>
          </div>
          <figure class={`reveal ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
            <Image
              src={spotlightImages[sp.image]}
              alt={sp.imageAlt}
              class="w-full h-auto object-cover max-h-[34rem] object-top"
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 50vw, 100vw"
              quality={80}
            />
            <figcaption class="mt-3 text-white/80 text-sm">{sp.caption}</figcaption>
          </figure>
        </div>
      </section>
    ))
  }

  <!-- Today's club colors -->
  <section class="bg-chalk border-b border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-14 lg:py-20 grid lg:grid-cols-[1.3fr_1fr] gap-10 items-center">
      <figure class="reveal">
        <Image
          src={relayExchange}
          alt="Chloe Carter passes the baton to Maryann Akpobassa mid-race for Track Houston at a championship meet."
          class="w-full h-auto object-cover"
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1024px) 60vw, 100vw"
          quality={80}
        />
        <figcaption class="mt-3 text-steel text-sm">
          Following in their footsteps: Chloe Carter hands off to Maryann Akpobassa for Track Houston.
        </figcaption>
      </figure>
      <div>
        <SectionHeading kicker="The Pathway" title="The next Olympian is at practice right now." />
        <p class="reveal mt-5 text-ink/80 leading-relaxed">
          Every spotlight athlete on this page started exactly where our current athletes are —
          at a Track Houston practice. Development, competition, championships.
        </p>
      </div>
    </div>
  </section>

  <!-- Current champions -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-20 lg:py-28">
    <SectionHeading kicker="Right Now" title="2026 national champions" />
    <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        athletes.current.map((a) => (
          <li class="reveal border border-line p-6 flex flex-col gap-2">
            <p class="kicker text-th-red">{a.division}</p>
            <p class="display text-3xl">{a.name}</p>
            <p class="text-ink/75 text-[0.95rem] leading-relaxed mt-1">{a.highlight}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- College -->
  <section id="college" class="bg-chalk border-y border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-20 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <SectionHeading kicker="College Pipeline" title={athletes.college.headline} />
          <p class="reveal mt-6 text-ink/80 leading-relaxed max-w-lg">{athletes.college.body}</p>
          <p class="reveal mt-4 text-steel text-sm max-w-lg">{athletes.college.note}</p>
          <div class="mt-8 flex flex-wrap gap-4">
            <CTAButton href="/alumni" variant="secondary">Meet Our Alumni</CTAButton>
            <CTAButton href="/programs" variant="secondary">The Scholars Program</CTAButton>
          </div>
        </div>
        <ul class="reveal flex flex-wrap gap-2.5 content-start" aria-label="Colleges where Track Houston alumni have competed">
          {
            athletes.college.schools.map((s) => (
              <li class="font-condensed font-semibold uppercase tracking-[0.08em] text-sm border border-ink/25 px-3.5 py-1.5 bg-white">
                {s}
              </li>
            ))
          }
          <li class="font-condensed font-semibold uppercase tracking-[0.08em] text-sm px-3.5 py-1.5 bg-th-red text-white">
            + 25 more
          </li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
