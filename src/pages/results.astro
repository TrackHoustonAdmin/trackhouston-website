---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Ticker from '../components/Ticker.astro';
import CTAButton from '../components/CTAButton.astro';
import results from '../data/results.json';
import full2026 from '../data/results2026.json';
import lewisRelay from '../assets/photos/lewis-relay.jpg';

const PLACE_LABELS: Record<number, string> = {
  1: 'Gold', 2: 'Silver', 3: 'Bronze', 4: '4th Place',
  5: '5th Place', 6: '6th Place', 7: '7th Place', 8: '8th Place',
};
const groups = [1, 2, 3, 4, 5, 6, 7, 8]
  .map((p) => ({ place: p, label: PLACE_LABELS[p], rows: full2026.results.filter((r) => r.place === p) }))
  .filter((g) => g.rows.length > 0);
---

<Layout
  title="Results, Championships & Records — Track Houston Youth Track Club"
  description="189 medals and 17 titles at the 2026 USATF National Junior Olympics, a 46.85 national record in the 11-12 boys 4x100m, and two decades of championship results."
>
  <PageHero
    kicker="Results & Records"
    title="The receipts."
    intro="Every year Track Houston qualifies more athletes for the national Junior Olympics — and brings home more medals — than any other track club in the country."
    image={lewisRelay}
    imageAlt="A Track Houston relay runner brings home the baton in front of a championship crowd."
  />

  <Ticker items={results.ticker} />

  <!-- 2026 featured -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-20 lg:py-28">
    <div class="grid lg:grid-cols-[1fr_1.2fr] gap-12 lg:gap-20">
      <div>
        <SectionHeading kicker="2026" title="189 medals. 17 titles. One record." />
        <p class="reveal mt-6 text-ink/80 leading-relaxed">
          {results.featured2026.summary}
        </p>
        <div class="reveal mt-10 grid grid-cols-3 gap-6 border-t-2 border-ink pt-8">
          <div>
            <p class="display text-5xl sm:text-6xl text-th-red"><span data-countup="189">189</span></p>
            <p class="kicker text-steel mt-2">Final medal count</p>
          </div>
          <div>
            <p class="display text-5xl sm:text-6xl text-th-red"><span data-countup="17">17</span></p>
            <p class="kicker text-steel mt-2">National champions</p>
          </div>
          <div>
            <p class="display text-5xl sm:text-6xl text-th-red">46.85</p>
            <p class="kicker text-steel mt-2">11-12 Boys 4x100m national record</p>
          </div>
          <div>
            <p class="display text-5xl sm:text-6xl text-th-red"><span data-countup="36">36</span></p>
            <p class="kicker text-steel mt-2">Relays to medal</p>
          </div>
          <div>
            <p class="display text-5xl sm:text-6xl text-th-red"><span data-countup="45">45</span></p>
            <p class="kicker text-steel mt-2">Individuals to medal</p>
          </div>
        </div>
      </div>
      <div>
        <h3 class="reveal kicker text-steel">2026 National Junior Olympic highlights</h3>
        <ul class="reveal mt-4 divide-y divide-line border-y border-line">
          {
            results.featured2026.highlights.map((h) => (
              <li class="py-3.5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6">
                <span class="font-condensed font-semibold uppercase tracking-[0.04em] text-lg">{h.athlete}</span>
                <span class="text-steel text-sm sm:text-right">{h.result}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 2026 complete results: Gold to 8th -->
  <section id="honors" class="bg-ink text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-20 lg:py-28">
      <SectionHeading light kicker="2026 · Gold to 8th" title="Every podium finish." />
      <p class="reveal mt-5 max-w-2xl text-white/80 leading-relaxed">
        {full2026.meet} — {full2026.venue}. Every Track Houston result from gold through eighth
        place, with official times and marks.
      </p>

      <div class="mt-12 space-y-12">
        {
          groups.map((g) => (
            <div class="reveal">
              <h3
                class={`display text-3xl sm:text-4xl border-b-2 pb-2 ${
                  g.place === 1
                    ? 'text-th-red border-th-red'
                    : g.place <= 3
                      ? 'text-white border-white/50'
                      : 'text-white/70 border-white/25'
                }`}
              >
                {g.label}
                <span class="font-condensed text-lg align-middle text-white/50 tracking-[0.08em] uppercase ml-3">
                  {g.rows.length} {g.rows.length === 1 ? 'result' : 'results'}
                </span>
              </h3>
              <ul class="mt-4 divide-y divide-white/15">
                {g.rows.map((r) => (
                  <li class="py-2.5 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6">
                    <span class="font-condensed font-semibold uppercase tracking-[0.04em] text-lg sm:w-72 shrink-0">
                      {r.event} <span class="text-white/60">· {r.division}</span>
                      {'team' in r && r.team && <span class="text-white/60"> ({r.team} team)</span>}
                    </span>
                    <span class="flex-1 text-white/90">
                      {'name' in r && r.name ? r.name : 'Track Houston relay'}
                      {'note' in r && r.note && (
                        <span class="ml-2 bg-th-red text-white kicker px-2 py-0.5 whitespace-nowrap">{r.note}</span>
                      )}
                    </span>
                    <span class="display text-xl text-white/95 sm:text-right">{r.mark ?? ''}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="reveal mt-10 text-white/60 text-sm max-w-2xl">{full2026.note}</p>
    </div>
  </section>

  <!-- Archive links -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-20 lg:py-28">
    <div id="records" class="reveal grid md:grid-cols-3 gap-5">
      <a href="/results/records" class="group bg-ink text-white p-7 hover:bg-th-red transition-colors duration-150 flex flex-col">
        <p class="kicker text-th-red group-hover:text-white/85 transition-colors">The Record Book</p>
        <h2 class="display text-3xl mt-2">Club records</h2>
        <p class="text-white/75 group-hover:text-white/90 mt-3 text-sm leading-relaxed transition-colors">
          Every division, every event — including ten national-record marks from 1996 to 2026.
        </p>
        <span class="kicker mt-auto pt-5">Open →</span>
      </a>
      <a href="/results/archive" class="group bg-ink text-white p-7 hover:bg-th-red transition-colors duration-150 flex flex-col">
        <p class="kicker text-th-red group-hover:text-white/85 transition-colors">Championship History</p>
        <h2 class="display text-3xl mt-2">2005–2025 seasons</h2>
        <p class="text-white/75 group-hover:text-white/90 mt-3 text-sm leading-relaxed transition-colors">
          Twenty years of Junior Olympic recaps, athletic honors and meet results, season by season.
        </p>
        <span class="kicker mt-auto pt-5">Open →</span>
      </a>
      <a href="/results/archive" class="group bg-ink text-white p-7 hover:bg-th-red transition-colors duration-150 flex flex-col">
        <p class="kicker text-th-red group-hover:text-white/85 transition-colors">Original Documents</p>
        <h2 class="display text-3xl mt-2">1990–2011 archive</h2>
        <p class="text-white/75 group-hover:text-white/90 mt-3 text-sm leading-relaxed transition-colors">
          Complete national JO results digitized from the original books — every Track Houston
          appearance flagged.
        </p>
        <span class="kicker mt-auto pt-5">Open →</span>
      </a>
    </div>
  </section>
</Layout>
