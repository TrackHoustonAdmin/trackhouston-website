---
import Layout from '../../layouts/Layout.astro';
import CTAButton from '../../components/CTAButton.astro';
import { getCoachPeople } from '../../lib/coachProfiles';

export async function getStaticPaths() {
  return getCoachPeople().map((person) => ({ params: { slug: person.slug }, props: { person } }));
}

const { person } = Astro.props;
const initials = person.name.split(' ').map((n) => n[0]).slice(0, 2).join('');
const updateMailto = `mailto:Treasurer@TrackHouston.com?subject=${encodeURIComponent(`Coach Bio Update — ${person.name}`)}&body=${encodeURIComponent('My updated About Me:\n\n\n(Optional: attach a new photo.)')}`;
---

<Layout
  noindex
  title={`${person.name} — Track Houston Coaching Staff`}
  description={`${person.name}, ${person.roles.join(' · ')} at Track Houston Youth Track Club.`}
>
  <!-- Profile header -->
  <header class="bg-th-red text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 pt-14 pb-12 sm:pt-20 sm:pb-14">
      <p class="kicker text-white/85">
        <a href="/coaches" class="hover:text-white transition-colors">← Coaching Staff</a>
      </p>
      <div class="mt-6 flex flex-col sm:flex-row gap-8 sm:items-end">
        {
          person.photo ? (
            <img
              src={person.photo}
              alt={`${person.name} headshot`}
              class="w-40 h-40 sm:w-48 sm:h-48 object-cover object-top border-4 border-white shrink-0"
            />
          ) : (
            <p aria-hidden="true" class="display text-6xl w-40 h-40 sm:w-48 sm:h-48 bg-ink text-white flex items-center justify-center shrink-0">
              {initials}
            </p>
          )
        }
        <div class="min-w-0">
          <h1 class="display text-5xl sm:text-7xl">{person.name}</h1>
          <p class="kicker text-white/90 mt-3">{person.roles.join(' · ')}</p>
          <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-white/90 text-sm">
            {person.phone && (
              <li>
                <a href={`tel:${person.phone.replace(/[^0-9]/g, '')}`} class="hover:text-ink transition-colors">{person.phone}</a>
              </li>
            )}
            {person.email && (
              <li>
                <a href={`mailto:${person.email}`} class="hover:text-ink transition-colors">{person.email}</a>
              </li>
            )}
          </ul>
        </div>
      </div>
    </div>
  </header>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-12 lg:py-16 grid lg:grid-cols-[1.4fr_1fr] gap-12">
    <!-- About -->
    <section>
      <h2 class="kicker text-th-red">About</h2>
      {
        person.bio ? (
          <div class="reveal mt-4 text-ink/85 leading-relaxed space-y-4 max-w-2xl">
            {person.bio.split('\n').filter(Boolean).map((para) => <p>{para}</p>)}
          </div>
        ) : (
          <p class="reveal mt-4 text-steel max-w-2xl">
            Bio coming soon — {person.name.split(' ')[0]} is part of the Track Houston coaching
            family serving athletes across greater Houston.
          </p>
        )
      }
      <div class="mt-8">
        <a href={updateMailto} class="kicker bg-chalk border border-line px-4 py-2.5 hover:border-th-red hover:text-th-red transition-colors inline-block">
          Coach {person.name.split(' ')[0]}? Update your bio →
        </a>
      </div>
    </section>

    <!-- Credentials -->
    <aside class="lg:border-l lg:border-line lg:pl-10">
      <h2 class="kicker text-th-red">USATF Credentials</h2>
      {
        person.registered && (
          <p class="reveal mt-4 bg-ink text-white text-sm px-4 py-3 leading-relaxed">
            ✓ Listed in the USATF Coaches Registry — current USATF membership, SafeSport training
            and background screening.
          </p>
        )
      }
      {
        person.credentials.length > 0 ? (
          <ul class="reveal mt-4 divide-y divide-line border-y border-line">
            {person.credentials.map((c) => (
              <li class="py-2.5 text-sm flex items-baseline gap-3">
                <span class="text-th-red font-bold" aria-hidden="true">✓</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        ) : (
          !person.registered && <p class="reveal mt-4 text-steel text-sm">Credentials on file with the club.</p>
        )
      }
      <div class="mt-8">
        <CTAButton href="/locations" variant="secondary">Practice Locations</CTAButton>
      </div>
    </aside>
  </div>
</Layout>
