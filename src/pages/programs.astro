---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTAButton from '../components/CTAButton.astro';
import programs from '../data/programs.json';
import athleteSmile from '../assets/photos/athlete-smile.jpg';
import midDistance from '../assets/photos/mid-distance-race.jpg';
---

<Layout
  title="Programs & Age Groups — Track Houston Youth Track Club"
  description="Track & field and cross country programs for ages 7–18. Two-year age divisions, every experience level, and a proven pathway from development to the national Junior Olympics."
>
  <PageHero
    kicker="Programs"
    title="Every lane. Every level."
    intro="Track Houston is not just for elite athletes — it's where elite athletes are made. Ages 7–18, no tryouts, from first stride to national championships."
    image={midDistance}
    imageAlt="A Track Houston middle-distance runner battles for position in a championship race."
  />

  <!-- Pathway -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 py-20 lg:py-28">
    <SectionHeading kicker="The Pathway" title="Development → Competition → Championships" />
    <div class="mt-12 grid md:grid-cols-3 gap-px bg-line border border-line">
      {
        programs.pathway.map((p) => (
          <article class="reveal bg-white p-7 lg:p-9">
            <p class="display text-6xl text-line" aria-hidden="true">{p.stage}</p>
            <h2 class="font-condensed font-semibold uppercase tracking-[0.06em] text-2xl mt-4">{p.title}</h2>
            <p class="mt-3 text-ink/75 leading-relaxed text-[0.95rem]">{p.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Two programs -->
  <section class="bg-th-red text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-20 lg:py-28 grid lg:grid-cols-2 gap-12">
      <article class="reveal border border-white/30 p-8 lg:p-10">
        <p class="kicker text-white/85">February – July</p>
        <h2 class="display text-4xl sm:text-5xl mt-3">Track & Field</h2>
        <p class="mt-5 text-white/90 leading-relaxed">
          Sprints, hurdles, distance, relays, jumps, throws and combined events across nine practice
          sites. The season builds from the Track Houston Opener through Houston-area invitationals
          to the Gulf Association, Region and National Junior Olympic championships.
        </p>
      </article>
      <article class="reveal border border-white/30 p-8 lg:p-10">
        <p class="kicker text-white/85">September – December</p>
        <h2 class="display text-4xl sm:text-5xl mt-3">Cross Country</h2>
        <p class="mt-5 text-white/90 leading-relaxed">
          Fall base-building and racing at three park sites — Cypress, Katy and Sugar Land — through
          local invitationals to the USATF National Junior Olympic Cross Country Championships.
        </p>
      </article>
    </div>
  </section>

  <!-- Age divisions -->
  <section id="age-divisions" class="mx-auto max-w-7xl px-4 sm:px-6 py-20 lg:py-28">
    <SectionHeading kicker="Age Divisions" title="Two years at a time." />
    <div class="reveal mt-10 overflow-x-auto">
      <table class="w-full min-w-[640px] border-collapse text-left">
        <caption class="sr-only">Track Houston age divisions, birth years and event limits</caption>
        <thead>
          <tr class="border-b-2 border-ink">
            <th scope="col" class="kicker text-steel py-3 pr-6">Division</th>
            <th scope="col" class="kicker text-steel py-3 pr-6">Birth Years</th>
            <th scope="col" class="kicker text-steel py-3 pr-6">Event Limit</th>
            <th scope="col" class="kicker text-steel py-3">Notes</th>
          </tr>
        </thead>
        <tbody>
          {
            programs.ageDivisions.map((d) => (
              <tr class="border-b border-line">
                <td class="py-4 pr-6 display text-2xl text-th-red whitespace-nowrap">{d.division}</td>
                <td class="py-4 pr-6 font-medium whitespace-nowrap">{d.birthYears}</td>
                <td class="py-4 pr-6 whitespace-nowrap">{d.maxEvents}</td>
                <td class="py-4 text-steel text-sm">{d.notes}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <ul class="reveal mt-6 space-y-2 text-steel text-sm max-w-3xl list-disc pl-5">
      {programs.ageDivisionNotes.map((n) => <li>{n}</li>)}
    </ul>
  </section>

  <!-- Scholars -->
  <section id="scholars" class="bg-chalk border-y border-line">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-20 lg:py-28 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <SectionHeading kicker="Scholars Program" title={programs.scholars.headline} />
        <p class="reveal mt-6 text-ink/80 leading-relaxed max-w-lg">{programs.scholars.body}</p>
        <div class="reveal mt-8 border-l-4 border-th-red bg-white p-6 max-w-lg">
          <h3 class="font-condensed font-semibold uppercase tracking-[0.05em] text-xl">
            {programs.scholars.club800.title}
          </h3>
          <p class="mt-2 text-ink/75 text-[0.95rem] leading-relaxed">{programs.scholars.club800.body}</p>
          <p class="mt-3 text-sm text-steel">
            Contact: <a href={`mailto:${programs.scholars.club800.contact.email}`} class="text-ink underline decoration-th-red decoration-2 underline-offset-4 hover:text-th-red transition-colors">{programs.scholars.club800.contact.name}</a>
          </p>
        </div>
        <div class="mt-8">
          <CTAButton href="/athletes" variant="secondary">See Where Alumni Compete</CTAButton>
        </div>
      </div>
      <div class="reveal">
        <Image
          src={athleteSmile}
          alt="A smiling young Track Houston athlete lines up with teammates before a race."
          class="w-full h-auto object-cover"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          quality={78}
        />
      </div>
    </div>
  </section>
</Layout>
